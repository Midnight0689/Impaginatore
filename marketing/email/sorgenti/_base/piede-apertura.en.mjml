<!-- Apertura del piè di pagina: filetto, simbolo e payoff. Segue la riga «perché ricevi questa email»
     scritta nel singolo modello, poi piede-servizio o piede-campagna. -->
<mj-section padding="40px 40px 0">
  <mj-column>
    <mj-divider />
  </mj-column>
</mj-section>
<mj-section padding="24px 40px 0">
  <mj-column>
    <mj-text>
      <table role="presentation" border="0" cellpadding="0" cellspacing="0">
        <tr>
          <td width="40" valign="middle" style="width:40px;"><img class="img-chiaro" src="{{base_immagini}}/simbolo.png" width="40" height="36" alt="" style="display:block;border:0;width:40px;height:36px;"><!--[if !mso]><!--><img class="img-scuro" src="{{base_immagini}}/simbolo-scuro.png" width="40" height="36" alt="" style="display:none;max-height:0;overflow:hidden;border:0;width:40px;height:36px;"><!--<![endif]--></td>
          <td valign="middle" style="padding-left:8px;font-family:Newsreader,'Iowan Old Style',Georgia,'Times New Roman',serif;font-size:20px;line-height:24px;font-weight:500;color:#236743;" class="serif c-acc">Yours to keep.</td>
        </tr>
      </table>
    </mj-text>
  </mj-column>
</mj-section>

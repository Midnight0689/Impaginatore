<!-- Service footer (transactional emails): sender identity and contacts. -->
<mj-section padding="12px 40px 48px">
  <mj-column>
    <mj-text mj-class="nota">
      {{titolare}} · {{indirizzo}} · VAT {{partita_iva}}<br>
      <a class="lnk" href="{{sito}}">{{sito_testo}}</a> · <a class="lnk" href="mailto:{{email_supporto}}">{{email_supporto}}</a> · <a class="lnk" href="{{link_privacy}}">Privacy notice</a>
    </mj-text>
  </mj-column>
</mj-section>
